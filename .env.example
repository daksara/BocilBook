# All of these are optional. With none set, BocilBook runs entirely on the
# built-in mock AI provider and in-memory store — no backend required.

# --- AI (Groq primary, Gemini fallback) ---
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Supabase (optional persistence for books) ---
# Project Settings -> API in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional: lets server-side API routes bypass RLS. Keep this secret.
SUPABASE_SERVICE_ROLE_KEY=
